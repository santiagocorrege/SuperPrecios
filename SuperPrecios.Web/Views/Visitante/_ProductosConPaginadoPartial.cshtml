@model SuperPrecios.Web.Models.Producto.VMProductoCompletoWPaginado

@* CSS específico para que el badge de categoría envuelva texto largo *@
<style>
    .category-badge {
        white-space: normal;
        word-break: break-word;
    }
</style>

<div class="row">    
    <aside class="col-lg-2 col-md-3 mb-4">
        <div class="card">
            <div class="card-header">
                Filtrar por
            </div>
            <div class="card-body">
                @if (Model.Categoria != null)
                {
                    <h6 class="mb-2">Categoría actual</h6>
                    <span class="badge bg-primary rounded-pill px-3 py-1 category-badge d-block text-center">
                        @Model.Categoria
                    </span>
                }
                else
                {
                    <p class="text-muted">Mostrando todas las categorías</p>
                }

                <hr />

                <h6>Categorias populares</h6>
                <ul class="list-unstyled">                    
                    <li>
                        <a asp-action="ProductosPorCategoria" asp-route-categoriaId="1">
                            Almacen
                        </a>
                    </li>
                    <li>
                        <a asp-action="ProductosPorCategoria" asp-route-categoriaId="125">
                            Bebidas
                        </a>
                    </li>
                    <li>
                        <a asp-action="ProductosPorCategoria" asp-route-categoriaId="3">
                            Jugos
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </aside>

    <!-- GRID DE PRODUCTOS (más ancho) -->
    <section class="col-lg-10 col-md-9">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @if (Model?.Productos?.Any() == true)
            {
                @foreach (var item in Model.Productos)
                {
                    <div class="col">
                        <div class="card h-100">
                            <!-- Imagen con proporción fija 4:3 -->
                            <div class="ratio ratio-4x3">
                                @if (!string.IsNullOrWhiteSpace(item.ImagenUrl))
                                {
                                    <img src="@item.ImagenUrl"
                                         class="img-fluid object-fit-cover"
                                         alt="@item.Nombre" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center bg-light">
                                        <i class="bi bi-image fs-2 text-muted"></i>
                                    </div>
                                }
                            </div>

                            <div class="card-body d-flex flex-column">
                                <h6 class="text-secondary mb-1">
                                    @(item.Marca?.Nombre ?? "Sin Marca")
                                </h6>
                                <h5 class="card-title">@(item.Nombre ?? "—")</h5>
                                <p class="card-text mb-4">
                                    <strong>Categoría:</strong>
                                    @(item.Categoria?.Nombre ?? "Sin Categoría")
                                </p>

                                @if (item.PreciosHistoricos?.Any() == true)
                                {
                                    <ul class="list-unstyled mt-auto">
                                        @foreach (var ph in item.PreciosHistoricos)
                                        {
                                            <li class="d-flex justify-content-between">
                                                <small class="text-muted">
                                                    @(ph.Supermercado?.Nombre ?? "—")
                                                </small>
                                                <span class="fw-bold">
                                                    $@ph.Precio.ToString("N2")
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="text-muted mt-auto">No hay precios hoy</p>
                                }
                            </div>

                            <div class="card-footer bg-white text-center border-0">
                                <a asp-action="ProductoDetail"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-primary btn-sm me-1">
                                    Detalles
                                </a>
                                <button class="btn btn-success btn-sm">Agregar</button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-danger text-center align-self-center">
                    No hay resultados de búsqueda
                </div>
            }
        </div>

        @* Paginado abajo del grid *@
        @await Html.PartialAsync("_PaginadoPartial", Model)
    </section>
</div>
