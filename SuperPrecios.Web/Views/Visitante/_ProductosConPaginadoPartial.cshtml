@model SuperPrecios.Web.Models.Producto.VMProductoCompletoWPaginado

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    @if (Model != null && Model.Productos != null)
    {
        @foreach (var item in Model.Productos ?? Enumerable.Empty<SuperPrecios.Application.DTO.Producto.DtoProductoCompleto>())
        {
            <div class="col">
                <div class="card h-100 position-relative">
                    @if (!string.IsNullOrWhiteSpace(item.ImagenUrl))
                    {
                        <img src="@item.ImagenUrl"
                        class="card-img-top product-img"
                        alt="@(item.Nombre ?? String.Empty)" />
                    }
                    else
                    {
                        <div class="product-placeholder">
                            <i class="bi bi-image" style="font-size: 2rem;"></i>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        <h6 class="text-secondary mb-1">
                            @(item.Marca?.Nombre ?? "Sin Marca")
                        </h6>
                        <h5 class="card-title">
                            @(item.Nombre ?? "—")
                        </h5>
                        <p class="card-text">
                            <strong>Categoría:</strong>
                            @(item.Categoria?.Nombre ?? "Sin Categoría")
                        </p>

                        @if (item.PreciosHistoricos?.Any() == true)
                        {
                            <ul class="list-unstyled mt-auto">
                                @foreach (var ph in item.PreciosHistoricos)
                                {
                                    <li class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">
                                            @(ph.Supermercado?.Nombre ?? "—")
                                        </small>
                                        <span class="fw-bold">
                                            $@ph.Precio.ToString("N2")
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted mt-auto">No hay precios hoy</p>
                        }
                    </div>

                    <div class="card-footer bg-white text-center border-0">
                        <a asp-action="ProductoDetail" asp-route-id="@item.Id"
                        class="btn btn-outline-primary btn-sm me-1">
                            Detalles
                        </a>
                        <button class="btn btn-success btn-sm">
                            Agregar
                        </button>
                    </div>
                </div>
            </div>
        }


    }
    else
    {
        <div class="alert alert-danger">No hay resultados de busqueda</div>
    }

</div>

@await Html.PartialAsync("_PaginadoPartial", Model)
