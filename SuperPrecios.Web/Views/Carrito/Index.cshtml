@{
    ViewData["Title"] = "Mi Carrito";
}

<div class="container my-4">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">
                <i class="bi bi-cart3 me-2"></i>Mi Carrito de Compras
            </h2>
        </div>
    </div>

    <div id="carrito-contenido">
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2">Cargando carrito...</p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/carrito.js"></script>
    <script>
        $(document).ready(function() {
            // Cargar carrito desde servidor
            $.get('/Carrito/Contenido').done(function(html) {
                $('#carrito-contenido').html(html);
            });
        });
    </script>
}
