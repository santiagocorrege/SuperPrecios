@using Microsoft.AspNetCore.Identity
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-light bg-white border-bottom box-shadow mb-3 py-1">
            <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap gap-2">

                <!-- IZQUIERDA -->
                <div class="d-flex align-items-center gap-3">
                    <a class="navbar-brand mb-0 h1 text-primary" asp-controller="Home" asp-action="Index">
                        SuperPrecios
                    </a>
                    @if (!User.IsInRole("Administrador"))
                    {
                        <a class="nav-link text-primary p-0" asp-controller="Visitante" asp-action="Productos">
                            <i class="bi bi-box me-1"></i> Productos
                        </a>
                    }
                    @if (User.IsInRole("Administrador"))
                    {
                        <a class="nav-link text-primary p-0" asp-controller="Miembro" asp-action="Index">Miembro</a>
                        <a class="nav-link text-primary p-0" asp-controller="Proveedor" asp-action="Index">Proveedor</a>
                        <a class="nav-link text-primary p-0" asp-controller="Producto" asp-action="Index">Producto</a>
                        <a class="nav-link text-primary p-0" asp-controller="Categoria" asp-action="Index">Categoria</a>
                        <a class="nav-link text-primary p-0" asp-controller="Marca" asp-action="Index">Marca</a>
                    }
                </div>
                

                <!-- CENTRO: BARRA DE BÚSQUEDA -->
                @if (!User.IsInRole("Administrador"))
                {
                    <form class="flex-grow-1 d-flex justify-content-left"
                          asp-controller="Visitante"
                          asp-action="Productos"
                          method="get"
                          role="search">
                        <div class="input-group w-100" style="max-width: 700px; min-width: 200px;">
                            <input class="form-control" type="search" name="busqueda" placeholder="Buscar productos" aria-label="Buscar" />
                            <button class="btn btn-outline-success" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                }

                <!-- DERECHA -->
                <ul class="navbar-nav flex-row">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <li class="nav-item">
                            <a href="#" class="nav-link text-primary p-0"
                               onclick="event.preventDefault(); document.getElementById('logoutForm').submit();">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </a>
                            <form id="logoutForm" asp-controller="Home" asp-action="Logout" method="post" class="d-none">
                                @Html.AntiForgeryToken()
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-2">
                            <a class="nav-link text-primary p-0" asp-controller="Home" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Login
                            </a>
                        </li>
                    }
                </ul>

            </div>
        </nav>
    </header>



    <main role="main" class="flex-fill container pb-3">
        <partial name="_Messages" />
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted mt-auto">
        <div class="container">
            &copy; 2025 - MVC - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/productos-paginado.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
