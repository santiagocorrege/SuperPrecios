@using Microsoft.AspNetCore.Identity
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MVC</title>

    <!-- Bootstrap y estilos -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/categorias.css" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <!-- Navbar principal -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-0 py-1">
            <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap gap-2">

                <!-- IZQUIERDA -->
                <div class="d-flex align-items-center gap-3">
                    <a class="navbar-brand mb-0 h1 text-primary"
                       asp-controller="Home" asp-action="Index">
                        SuperPrecios
                    </a>
                    @if (!User.IsInRole("Administrador"))
                    {
                        <a class="nav-link text-primary p-0"
                           asp-controller="Visitante" asp-action="Productos">
                            <i class="bi bi-box me-1"></i> Productos
                        </a>
                    }
                    @if (User.IsInRole("Administrador"))
                    {
                        <a class="nav-link text-primary p-0" asp-controller="Miembro" asp-action="Index">Miembro</a>
                        <a class="nav-link text-primary p-0" asp-controller="Proveedor" asp-action="Index">Proveedor</a>
                        <a class="nav-link text-primary p-0" asp-controller="Producto" asp-action="Index">Producto</a>
                        <a class="nav-link text-primary p-0" asp-controller="Categoria" asp-action="Index">Categoria</a>
                        <a class="nav-link text-primary p-0" asp-controller="Marca" asp-action="Index">Marca</a>
                    }
                </div>

                <!-- CENTRO: Búsqueda -->
                @if (!User.IsInRole("Administrador"))
                {
                    <form class="flex-grow-1 d-flex justify-content-left"
                          asp-controller="Visitante" asp-action="Productos"
                          method="get" role="search">
                        <div class="input-group w-100" style="max-width: 700px; min-width: 200px;">
                            <input class="form-control" type="search" name="busqueda"
                                   placeholder="Buscar productos" aria-label="Buscar" />
                            <button class="btn btn-outline-success" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>
                }

                <!-- DERECHA: Mini-carrito + Login/Usuario -->
                <ul class="navbar-nav ms-auto flex-row align-items-center">
                    @if (User.IsInRole("Miembro"))
                    {
                        <!-- Mini-carrito para miembros -->
                        <li class="nav-item me-3" id="mini-carrito-container">
                            <!-- El contenido se carga desde localStorage -->
                            <a class="nav-link d-flex align-items-center p-0" href="/Carrito">
                                <i class="bi bi-cart3 fs-4"></i>
                                <span class="ms-2 d-none d-lg-inline">Cargando...</span>
                            </a>
                        </li>
                    }

                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <!-- Dropdown del usuario autenticado -->
                        <li class="nav-item dropdown position-relative">
                            <a class="nav-link dropdown-toggle d-flex align-items-center p-0"
                               href="#"
                               id="userDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               data-bs-display="static"
                               aria-expanded="false">
                                <i class="bi bi-person-circle fs-4"></i>
                                <span class="ms-2 d-none d-lg-inline">@User.Identity.Name</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                                <li>
                                    <a class="dropdown-item d-flex align-items-center"
                                       asp-controller="Profile" asp-action="Index">
                                        <i class="bi bi-person me-2"></i> Perfil
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center"
                                       asp-controller="Account" asp-action="Settings">
                                        <i class="bi bi-gear me-2"></i> Configuración
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Home" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="dropdown-item d-flex align-items-center p-0">
                                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <!-- Login para usuarios no autenticados -->
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center p-0"
                               asp-controller="Home" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right fs-4"></i>
                                <span class="ms-2 d-none d-lg-inline">Login</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </nav>

        @* Navbar secundaria para categorías (solo visitantes) *@
        @if (!User.IsInRole("Administrador"))
        {
            <nav class="navbar mb-4" style="background-color: #0a4eb3; color: white; padding: 0.5rem 1rem;">
                <div class="container-fluid">
                    <button id="btn-open-categorias" class="btn btn-link text-white p-0">
                        <i class="fas fa-bars me-1"></i>Categorías
                    </button>
                </div>
            </nav>

            @* Inyección del ViewComponent de categorías *@
            @await Component.InvokeAsync("Categorias")
        }
    </header>

    <main role="main" class="flex-fill container pb-3">
        <partial name="_Messages" />
        @RenderBody()
    </main>

    @* <footer class="border-top footer text-muted mt-auto"> *@
    @*     <div class="container"> *@
    @*         &copy; 2025 - MVC - <a asp-controller="Home" asp-action="Privacy">Privacy</a> *@
    @*     </div> *@
    @* </footer> *@

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/productos-paginado.js"></script>
    <script src="~/js/categorias.js"></script>
    <script src="~/js/carrito.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- ===== MODALES DE CONFIRMACIÓN DEL CARRITO ===== -->
    <!-- Agregar este HTML justo ANTES del cierre </body> en _Layout.cshtml -->
    <!-- Modal para eliminar producto -->
    <div class="modal fade" id="modal-eliminar-producto" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title text-danger" id="modalEliminarLabel">
                        <i class="bi bi-exclamation-triangle me-2"></i>Eliminar Producto
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <div class="mb-3">
                        <i class="bi bi-trash text-danger" style="font-size: 3rem;"></i>
                    </div>
                    <h6>¿Estás seguro?</h6>
                    <p class="text-muted mb-0">Este producto se eliminará de tu carrito</p>
                </div>
                <div class="modal-footer border-0 pt-0 justify-content-center">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i>Cancelar
                    </button>
                    <button type="button" class="btn btn-danger px-4" id="btn-confirmar-eliminar">
                        <i class="bi bi-trash me-1"></i>Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para vaciar carrito -->
    <div class="modal fade" id="modal-vaciar-carrito" tabindex="-1" aria-labelledby="modalVaciarLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title text-warning" id="modalVaciarLabel">
                        <i class="bi bi-exclamation-triangle me-2"></i>Vaciar Carrito
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <div class="mb-3">
                        <i class="bi bi-cart-x text-warning" style="font-size: 3rem;"></i>
                    </div>
                    <h6>¿Vaciar todo el carrito?</h6>
                    <p class="text-muted mb-0">Se eliminarán todos los productos. Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer border-0 pt-0 justify-content-center">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i>Cancelar
                    </button>
                    <button type="button" class="btn btn-warning px-4" id="btn-confirmar-vaciar">
                        <i class="bi bi-trash3 me-1"></i>Vaciar Carrito
                    </button>
                </div>
            </div>
        </div>
    </div>
</body>
</html>