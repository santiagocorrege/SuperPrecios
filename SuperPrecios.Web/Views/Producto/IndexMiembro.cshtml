@model IEnumerable<SuperPrecios.Application.DTO.Producto.DtoProductoGet>

@{
    ViewData["Title"] = "Listado de Productos";
}

<style>
    .product-img {
        width: 100%;
        height: 200px;
        object-fit: contain;
        background-color: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .product-placeholder {
        width: 100%;
        height: 200px;
        background-color: #e0e0e0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #888;
        font-size: 14px;
    }
</style>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    @foreach (var item in Model ?? Enumerable.Empty<SuperPrecios.Application.DTO.Producto.DtoProductoGet>())
    {
        <div class="col">
            <div class="card h-100">
                @if (!string.IsNullOrWhiteSpace(item.ImagenUrl))
                {
                    <img src="@item.ImagenUrl" class="card-img-top product-img" alt="@item.Nombre" />
                }
                else
                {
                    <div class="product-placeholder">
                        Sin imagen
                    </div>
                }
                <div class="card-body">
                    <h5 class="card-title">@item.Nombre</h5>
                    <p class="card-text">
                        <strong>Marca:</strong> @(item.Marca?.Nombre ?? "Sin Marca")<br />
                        <strong>Categoría:</strong> @(item.Categoria?.Nombre ?? "Sin Categoría")<br />
                        <strong>Precio:</strong> $@item.Precio
                    </p>
                </div>
                <div class="card-footer text-center">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm me-1">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm me-1">Eliminar</a>
                    <button class="btn btn-success btn-sm">Agregar</button>
                </div>
            </div>
        </div>
    }
</div>
