@model SuperPrecios.Application.DTO.Proveedor.DtoProveedorAdd

@{
    ViewData["Title"] = "Registro de Proveedor";
}

<div class="container d-flex justify-content-center align-items-center mt-5">
    <div class="border rounded p-4 shadow-sm text-center" style="width: 100%; max-width: 500px;">
        <img src="~/img/logo.png"
             alt="SuperPrecios"
             class="mx-auto d-block mb-4"
             style="height: 100px;" />
        <h2 class="mb-2">Registro</h2>
        <form asp-action="Proveedor" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3 text-start">
                <label asp-for="SupermercadoNombre" class="form-label"></label>
                <input asp-for="SupermercadoNombre" class="form-control" />
                <span asp-validation-for="SupermercadoNombre" class="text-danger"></span>
            </div>

            <div class="form-group mb-3 text-start">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-group mb-3 text-start">
                <label asp-for="Apellido" class="form-label"></label>
                <input asp-for="Apellido" class="form-control" />
                <span asp-validation-for="Apellido" class="text-danger"></span>
            </div>

            <div class="form-group mb-3 text-start">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-4 text-start">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-primary">Registrarme</button>
            </div>
        </form>

        <div class="text-center mt-3" style="font-size: 0.9rem;">
            <span class="text-muted">¿Sos miembro?</span>
            <a asp-action="Miembro" class="fw-bold text-decoration-none ms-1">Registrate como miembro</a>
        </div>

        <div class="text-center mt-2" style="font-size: 0.9rem;">
            <a asp-action="Login" asp-controller="Home" class="text-decoration-none">¿Ya tenés cuenta? Iniciar sesión</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
