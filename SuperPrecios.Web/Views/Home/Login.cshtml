@model SuperPrecios.Web.Models.Usuario.VMUsuarioLogin

@{
    ViewData["Title"] = "Login";
}

<div class="container border mt-5 p-4" style="max-width: 500px;">

    <img src="~/img/logo.png"
         alt="SuperPrecios"
         class="mx-auto d-block mb-4"
         style="height: 100px;" />

    <form method="post">
        <div class="form-group mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="form-control" />
        </div>

        <div class="form-group form-check mb-4">
            <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
            <label asp-for="RememberMe" class="form-check-label" for="rememberMeCheck">Recuérdame</label>
        </div>

        <div class="d-grid">
            <button type="submit" class="btn btn-primary">Login</button>
        </div>
    </form>

    <div class="text-center mt-3">
        <span class="text-muted">¿No tenés una cuenta? </span>
        <a asp-controller="Registro" asp-action="Miembro" class="fw-bold text-decoration-none">Registrate</a>
    </div>
</div>
